# Copy to .env and change the secrets.
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me_too
JWT_SECRET=change_me_long_random_string
INTERNAL_SERVICE_KEY=change_me_another_long_random_string

# Optional (password-reset emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# URLs as seen from the BROWSER (baked into the frontend at build time)
VITE_API_BASE_URL=http://localhost:8080
VITE_AI_STREAM_BASE_URL=http://localhost:8091
CORS_ALLOWED_ORIGINS=http://localhost:3000

# AI service
MAX_CAMERAS=3
